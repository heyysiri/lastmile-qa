OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
RUNNER_PORT=4000
RUNNER_API_TOKEN=local-development-runner
TEST_API_TOKEN=local-development-test
ENABLE_TEST_API=true
SELLER_DEMO_URL=http://127.0.0.1:3001
QA_DATABASE_PATH=.data/qa.sqlite
SELLER_DATABASE_PATH=.data/seller.sqlite
ARTIFACT_ROOT=artifacts/runs
# Optional, explicitly labeled local demo defect. Leave empty for the healthy app.
SELLER_DEMO_DEFECT=

# Optional GitHub repository cloning and verified-fix PR publication. Server-only.
# Limit repository permissions to contents and pull requests for the intended fork.
GITHUB_PAT=

# Clerk: keys must come from the same Clerk application. Use test keys locally.
# A public DASHBOARD_ORIGIN requires Clerk. Use live keys for deployment.
LASTMILE_AUTH=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# In Clerk mode RUNNER_API_TOKEN must be a random server-only secret, >=32 characters.
# Private workspaces never inherit GITHUB_PAT or the legacy shared database.
# DASHBOARD_ORIGIN=https://your-domain.example
