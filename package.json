{
  "name": "lastmile-qa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {"node": ">=22"},
  "scripts": {
    "start": "node scripts/dev.mjs --production",
    "dev": "node scripts/dev.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:study": "tsx scripts/demo-study.ts",
    "demo:investigate": "tsx scripts/demo-investigate.ts",
    "oscar:setup": "node scripts/setup-oscar.mjs",
    "oscar:start": "ENABLE_TEST_API=true TEST_API_TOKEN=local-development-test .local-work/p2/oscar-venv/bin/python integrations/oscar/manage.py runserver 127.0.0.1:8000 --noreload",
    "oscar:test": ".local-work/p2/oscar-venv/bin/python integrations/oscar/manage.py test test_bridge",
    "mcp": "node scripts/mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@strands-agents/sdk": "1.26.0",
    "better-sqlite3": "13.2.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "openai": "^6.16.0",
    "playwright": "^1.58.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.58.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.7",
    "eslint": "^9.39.2",
    "typescript-eslint": "^8.53.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {"onlyBuiltDependencies": ["better-sqlite3", "esbuild"]}
}
